# Agentic AI Intelligent Loan Approval System - Environment Variables

# ============================================================================
# ANTHROPIC API Configuration
# ============================================================================
# Get your API key from: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxx-your-api-key-here-xxx

# LLM Model to use for agents
ANTHROPIC_MODEL=claude-sonnet-4.6

# ============================================================================
# Application Configuration
# ============================================================================
# Environment: development, staging, production
APP_ENV=development

# API server host and port
API_HOST=0.0.0.0
API_PORT=8000

# Streamlit UI host and port
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# Enable debug mode
DEBUG=True

# ============================================================================
# Database Configuration
# ============================================================================
# Path to SQLite database file
DB_PATH=./data/loans.db

# Database backup directory
DB_BACKUP_PATH=./data/backups/

# ============================================================================
# MCP Server Endpoints (for future remote/distributed MCP servers)
# ============================================================================
# Currently all MCP servers are in-process, but these can be updated
# to point to remote MCP server endpoints

MCP_APPLICANT_DB_ENDPOINT=http://localhost:8001
MCP_RISK_RULES_DB_ENDPOINT=http://localhost:8002
MCP_DECISION_SYNTHESIS_ENDPOINT=http://localhost:8003
MCP_NOTIFICATION_SYSTEM_ENDPOINT=http://localhost:8004

# ============================================================================
# Logging Configuration
# ============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=DEBUG

# Log format: json (structured) or text (human-readable)
LOG_FORMAT=json

# Log file path
LOG_FILE=./logs/app.log

# Max log file size before rotation (MB)
LOG_MAX_SIZE_MB=100

# Number of log files to keep
LOG_BACKUP_COUNT=10

# ============================================================================
# Performance & Timeout Configuration
# ============================================================================
# Total request timeout (seconds)
REQUEST_TIMEOUT_SECONDS=30

# Individual agent timeout (seconds)
AGENT_TIMEOUT_SECONDS=2

# MCP server query timeout (seconds)
MCP_TIMEOUT_SECONDS=1

# LLM API timeout (seconds)
LLM_TIMEOUT_SECONDS=10

# ============================================================================
# Rate Limiting Configuration
# ============================================================================
# Max requests per window
RATE_LIMIT_REQUESTS=1000

# Time window in minutes
RATE_LIMIT_WINDOW_MINUTES=1

# ============================================================================
# Decision Rules & Thresholds (can be overridden via API)
# ============================================================================
# DTI thresholds
DTI_FAVORABLE_MAX=0.36
DTI_ACCEPTABLE_MAX=0.43
DTI_BORDERLINE_MAX=0.50
DTI_HIGH_RISK_MIN=0.50

# Credit score thresholds
CREDIT_EXCELLENT_MIN=750
CREDIT_GOOD_MIN=700
CREDIT_FAIR_MIN=650
CREDIT_POOR_MIN=550

# LTI thresholds
LTI_FAVORABLE_MAX=2.5
LTI_ACCEPTABLE_MAX=4.0
LTI_HIGH_RISK_MIN=4.0

# Decision confidence threshold (must be >= to auto-decide)
CONFIDENCE_THRESHOLD=0.75

# Anomaly detection threshold
ANOMALY_SCORE_THRESHOLD=0.6

# Max agent retries on failure
MAX_AGENT_RETRIES=2

# ============================================================================
# Feature Flags (for gradual rollout)
# ============================================================================
# Enable anomaly detection
ENABLE_ANOMALY_DETECTION=true

# Enable detailed explanations in decision output
ENABLE_DETAILED_EXPLANATIONS=true

# Enable notifications (if false, logs notifications instead)
ENABLE_NOTIFICATIONS=true

# ============================================================================
# Development/Testing Configuration
# ============================================================================
# Use mock data (don't connect to real services)
USE_MOCK_DATA=true

# Mock MCP server responses (for testing)
MOCK_MCP_RESPONSES=true

# Seed mock database on startup
SEED_MOCK_DB=true
