# Agentic AI Intelligent Loan Approval System - Production Environment Variables

# ============================================================================
# ANTHROPIC API Configuration
# ============================================================================
ANTHROPIC_API_KEY=sk-ant-xxx-your-api-key-here-xxx
ANTHROPIC_MODEL=claude-haiku-4-5

# ============================================================================
# Application Configuration
# ============================================================================
APP_ENV=production
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
DEBUG=False

# ============================================================================
# Database Configuration
# ============================================================================
DB_PATH=/var/lib/ai-loan-approval/loans.db
DB_BACKUP_PATH=/var/lib/ai-loan-approval/backups/

# ============================================================================
# MCP Server Endpoints
# ============================================================================
MCP_APPLICANT_DB_ENDPOINT=http://mcp-applicant-db:8001
MCP_RISK_RULES_DB_ENDPOINT=http://mcp-risk-rules-db:8002
MCP_DECISION_SYNTHESIS_ENDPOINT=http://mcp-decision-synthesis:8003
MCP_NOTIFICATION_SYSTEM_ENDPOINT=http://mcp-notification-system:8004

# ============================================================================
# Logging Configuration
# ============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=/var/log/ai-loan-approval/app.log
LOG_MAX_SIZE_MB=500
LOG_BACKUP_COUNT=20

# ============================================================================
# Performance & Timeout Configuration
# ============================================================================
REQUEST_TIMEOUT_SECONDS=30
AGENT_TIMEOUT_SECONDS=2
MCP_TIMEOUT_SECONDS=1
LLM_TIMEOUT_SECONDS=10

# ============================================================================
# Rate Limiting Configuration
# ============================================================================
RATE_LIMIT_REQUESTS=5000
RATE_LIMIT_WINDOW_MINUTES=1

# ============================================================================
# Decision Rules & Thresholds
# ============================================================================
DTI_FAVORABLE_MAX=0.36
DTI_ACCEPTABLE_MAX=0.43
DTI_BORDERLINE_MAX=0.50
DTI_HIGH_RISK_MIN=0.50

CREDIT_EXCELLENT_MIN=750
CREDIT_GOOD_MIN=700
CREDIT_FAIR_MIN=650
CREDIT_POOR_MIN=550

LTI_FAVORABLE_MAX=2.5
LTI_ACCEPTABLE_MAX=4.0
LTI_HIGH_RISK_MIN=4.0

CONFIDENCE_THRESHOLD=0.75
ANOMALY_SCORE_THRESHOLD=0.6
MAX_AGENT_RETRIES=2

# ============================================================================
# Feature Flags
# ============================================================================
ENABLE_ANOMALY_DETECTION=true
ENABLE_DETAILED_EXPLANATIONS=true
ENABLE_NOTIFICATIONS=true

# ============================================================================
# Development/Testing Configuration
# ============================================================================
USE_MOCK_DATA=false
MOCK_MCP_RESPONSES=false
SEED_MOCK_DB=false
